<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TetViet" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tet_red_primary</item>
        <item name="colorSecondary">@color/tet_gold</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.TetViet" parent="Base.Theme.TetViet" />

    <style name="Theme_TetViet_BottomSheetDialog" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/TetVietModalBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="TetVietModalBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Ô Ăn Quan v2: bảng chi tiết điểm trên thẻ kết quả -->
    <style name="OaqResultLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">3dp</item>
        <item name="android:fontFamily">@font/arimo_regular</item>
        <item name="android:textColor">#FF8D5524</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="OaqResultValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">52dp</item>
        <item name="android:paddingVertical">3dp</item>
        <item name="android:gravity">end</item>
        <item name="android:fontFamily">@font/arimo_bold</item>
        <item name="android:textColor">#FF5D2A12</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>