    <string name="customs_item_banh_chung_title">🍃 Nồi Bánh Chưng Xanh Ngày Tết</string>
    <string name="customs_item_banh_chung_desc">Bánh Chưng hình vuông tượng trưng cho Đất, bánh Tét hình trụ tượng trưng cho sự gắn bó đùm bọc. Đêm 29-30 Tết cả gia đình quây quần bên bếp lửa hồng nấu bánh chưng là khoảnh khắc thiêng liêng nhất của Tết sum vầy.</string>
