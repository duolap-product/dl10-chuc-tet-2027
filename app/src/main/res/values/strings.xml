    <!-- Horoscope Dialog -->
    <string name="horoscope_title">Tử Vi &amp; Tử Khởi Năm Đinh Mùi 2027</string>
    <string name="horoscope_subtitle">Mệnh Thiên Hà Thủy • Luận đoán vận hạn đầu năm</string>
    <string name="horoscope_section_overview_title">🔮 Tổng Quan Năm Đinh Mùi 2027</string>
    <string name="horoscope_section_overview_content">Năm 2027 là năm Đinh Mùi (con Dê), ngũ hành nạp âm Thiên Hà Thủy (Nước trên trời). Đây là năm mang năng lượng dung hòa, nhân ái, thích hợp khởi tạo các mối quan hệ lâu dài, phát triển tài lộc vững chắc.</string>
    <string name="horoscope_section_departure_title">🧭 Hướng Xuất Hành Đầu Năm (Mùng 1)</string>
    <string name="horoscope_section_departure_content">• Hỷ Thần: Hướng Tây Bắc (nghênh đón niềm vui, may mắn, hòa thuận gia đạo)\n• Tài Thần: Hướng Đông Nam (cầu tài lộc, công danh hanh thông)\n• Giờ Hoàng Đạo: Tý (23h-1h), Dần (3h-5h), Thìn (7h-9h), Tỵ (9h-11h)</string>
    <string name="horoscope_section_color_title">🎨 Màu Sắc Hợp Mệnh Năm 2027</string>
    <string name="horoscope_section_color_content">• Màu tương sinh (Kim sinh Thủy): Trắng, Ánh Kim, Bạc\n• Màu bản mệnh (Thủy): Xanh dương, Đen\n• Màu đại cát ngày Tết: Đỏ hoàng gia, Vàng tài lộc</string>

    <!-- Wishes Dialog -->
