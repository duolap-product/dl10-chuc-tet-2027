<?xml version="1.0" encoding="utf-8"?>
<!-- Hộp thoại điểm danh nhận lì xì: trạng thái "chưa nhận" (2 nút nhận) và "đã nhận" (số xu + hẹn ngày mai) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="24dp"
        android:background="@drawable/bg_dialog_wishing_modal"
        android:elevation="12dp"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <FrameLayout
            android:id="@+id/btnCloseCheckIn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_close_btn"
            android:clickable="true"
            android:contentDescription="@string/action_close"
            android:elevation="4dp"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_clear"
                app:tint="#7A090D" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/layoutCheckInHero"
            android:layout_width="120dp"
            android:layout_height="110dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/viewCheckInHalo"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_wishing_halo" />

            <ImageView
                android:id="@+id/ivCheckInDialogEnvelope"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_custom_red_packet" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvCheckInDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/lobster_regular"
            android:includeFontPadding="false"
            android:textColor="#8C1D24"
            android:textSize="24sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutCheckInHero"
            tools:text="Lì Xì Ngày 3" />

        <TextView
            android:id="@+id/tvCheckInDialogAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/arimo_bold"
            android:includeFontPadding="false"
            android:shadowColor="#40000000"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:textColor="#D9861C"
            android:textSize="34sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCheckInDialogTitle"
            tools:text="+150 xu"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvCheckInDialogDesc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/arimo_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:textColor="#6B3F21"
            android:textSize="13.5sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCheckInDialogAmount"
            tools:text="Điểm danh mỗi ngày, chuỗi càng dài lì xì càng lớn. Ngày 7 nhận 888 xu!" />

        <LinearLayout
            android:id="@+id/layoutDialogDays"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvCheckInDialogDesc" />

        <!-- Trạng thái chưa nhận -->
        <LinearLayout
            android:id="@+id/layoutClaimActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutDialogDays">

            <LinearLayout
                android:id="@+id/btnClaimDouble"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_wishing_cta_button"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_coin_gold" />

                <TextView
                    android:id="@+id/tvClaimDouble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arimo_bold"
                    android:includeFontPadding="false"
                    android:textColor="#FFFDF7"
                    android:textSize="14.5sp"
                    tools:text="Xem video nhận x2 (+300 xu)" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/btnClaimNormal"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_checkin_btn_waiting"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvClaimNormal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/arimo_bold"
                    android:includeFontPadding="false"
                    android:textColor="#7A090D"
                    android:textSize="14sp"
                    tools:text="Nhận +150 xu" />
            </FrameLayout>
        </LinearLayout>

        <!-- Trạng thái đã nhận -->
        <LinearLayout
            android:id="@+id/layoutClaimedActions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutClaimActions"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvComeBackTomorrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arimo_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#C62828"
                android:textSize="14sp"
                tools:text="Ngày mai quay lại nhận +200 xu nhé!" />

            <TextView
                android:id="@+id/tvReminderNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/arimo_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="#8A6040"
                android:textSize="12sp"
                tools:text="🔔 Mình sẽ nhắc bạn lúc 19:00 nếu bạn quên" />

            <TextView
                android:id="@+id/btnEnableReminder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="@font/arimo_bold"
                android:includeFontPadding="false"
                android:padding="6dp"
                android:text="@string/checkin_enable_reminder"
                android:textColor="#C62828"
                android:textSize="13sp"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/btnCheckInDone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_wishing_cta_button"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvCheckInDone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:fontFamily="@font/arimo_bold"
                    android:includeFontPadding="false"
                    android:textColor="#FFFDF7"
                    android:textSize="14.5sp"
                    tools:text="Chơi Bầu Cua ngay" />
            </FrameLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
