<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="24dp"
        android:background="@drawable/bg_dialog_wishing_modal"
        android:elevation="12dp"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <!-- Top-Left Blossom Decoration -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="-12dp"
            android:alpha="0.85"
            android:src="@drawable/ic_bg_blossom_branch_left"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Top-Right Blossom Decoration -->
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="-12dp"
            android:layout_marginEnd="-12dp"
            android:alpha="0.85"
            android:src="@drawable/ic_bg_blossom_branch_right"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Close Button (X) -->
        <FrameLayout
            android:id="@+id/btnCloseUserWishes"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_close_btn"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_clear"
                app:tint="#7A090D" />
        </FrameLayout>

        <!-- Dialog Title -->
        <LinearLayout
            android:id="@+id/layoutUserWishesTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/sticker_apricot_flower" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arimo_bold"
                android:includeFontPadding="false"
                android:text="@string/wishing_tree_my_wishes_title"
                android:textColor="#8C1D24"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Empty State Message -->
        <TextView
            android:id="@+id/tvEmptyWishes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="36dp"
            android:fontFamily="@font/arimo_regular"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:paddingHorizontal="16dp"
            android:text="@string/wishing_tree_my_wishes_empty"
            android:textColor="#8D6E63"
            android:textSize="13.5sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutUserWishesTitle" />

        <!-- Wishes List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUserWishes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:maxHeight="360dp"
            android:overScrollMode="never"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutUserWishesTitle"
            tools:itemCount="3"
            tools:listitem="@layout/item_user_wish" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>

