<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#650106">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_tet_screen" />

    <!-- Top Bar -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:background="@drawable/bg_lucky_header"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_lucky_button"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFF0C2" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/liberationsans_regular"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="5"
                android:text="@string/wheel_title"
                android:textColor="#FFF0C2"
                android:textSize="19.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:fontFamily="@font/liberationsans_regular"
                android:includeFontPadding="false"
                android:shadowColor="#B3000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:text="@string/wheel_subtitle"
                android:textColor="#E5BA6A"
                android:textSize="11.5sp" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnHistory"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_lucky_button"
            android:clickable="true"
            android:contentDescription="@string/wheel_history_title"
            android:elevation="6dp"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_recent_history"
                app:tint="#FFF0C2" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_lucky_button"
            android:clickable="true"
            android:contentDescription="@string/wheel_settings_title"
            android:elevation="6dp"
            android:focusable="true"
            android:visibility="gone">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_settings"
                app:tint="#FFF0C2" />

        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/liberationsans_bold"
                android:letterSpacing="0.04"
                android:padding="10dp"
                android:text="@string/wheel_banner_title"
                android:textColor="#FEE5AA"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Wheel Container -->
            <FrameLayout
                android:layout_width="330dp"
                android:layout_height="330dp"
                android:layout_marginTop="16dp">

                <online.duolap.tetviet.views.LuckyWheelView
                    android:id="@+id/luckyWheelView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/liberationsans_bold" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvWheelInstruction"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/liberationsans_regular"
                android:includeFontPadding="false"
                android:text="@string/wheel_instruction_default"
                android:textColor="#FEE5A2"
                android:textSize="13.5sp" />

            <!-- Main Spin Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSpin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:backgroundTint="#FFB300"
                android:elevation="8dp"
                android:fontFamily="@font/liberationsans_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.02"
                android:text="@string/wheel_btn_spin"
                android:textColor="#7A090D"
                android:textSize="17sp"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                app:strokeColor="#FFE59F"
                app:strokeWidth="2dp" />

            <!-- Sub Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="32dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCustomize"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/liberationsans_bold"
                    android:includeFontPadding="false"
                    android:text="@string/wheel_btn_customize"
                    android:textColor="#FEE5AA"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="#E5BA6A" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewHistory"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/liberationsans_bold"
                    android:includeFontPadding="false"
                    android:text="@string/wheel_btn_history"
                    android:textColor="#FEE5AA"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="#E5BA6A" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
