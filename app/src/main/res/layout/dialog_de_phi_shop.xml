<?xml version="1.0" encoding="utf-8"?>
<!-- Cửa hàng Dê: mua và chọn trang phục cho chú dê bằng xu (ví chung) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_wishing_modal"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="18dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/lobster_regular"
            android:includeFontPadding="false"
            android:text="@string/de_phi_shop_title"
            android:textColor="#8C1D24"
            android:textSize="25sp" />

        <LinearLayout
            android:id="@+id/chipShopCoins"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_checkin_btn_waiting"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_coin_gold" />

            <TextView
                android:id="@+id/tvShopCoins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/arimo_bold"
                android:textColor="#7A090D"
                android:textSize="14sp"
                tools:text="1.250" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/arimo_regular"
        android:text="@string/de_phi_shop_desc"
        android:textColor="#8D5524"
        android:textSize="12.5sp" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/layoutSkinGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
