<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_dialog"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="#D6C8B5" />

    <!-- Top Header: Success Badge + Title + Close Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_color_circle"
            android:backgroundTint="#2E7D32">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Thành công"
                android:src="@drawable/ic_check"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arimo_bold"
                android:includeFontPadding="false"
                android:text="@string/card_maker_saved_success_title"
                android:textColor="#7A090D"
                android:textSize="17.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/arimo_regular"
                android:includeFontPadding="false"
                android:text="@string/card_maker_saved_success_desc"
                android:textColor="#8C6E52"
                android:textSize="12sp" />

        </LinearLayout>

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnCloseSavedSheet"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_close"
            android:src="@drawable/ic_clear"
            app:tint="#7A090D" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#EFE2D2" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivSavedCardPreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        android:adjustViewBounds="true"
        android:maxHeight="320dp"
        android:scaleType="fitCenter" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDismissSavedCard"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#F5EEE2"
            android:fontFamily="@font/arimo_bold"
            android:includeFontPadding="false"
            android:text="@string/action_close"
            android:textAllCaps="false"
            android:textColor="#5E4B3C"
            android:textSize="14.5sp"
            app:cornerRadius="12dp"
            app:strokeColor="#D6C5B0"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShareSavedCard"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.6"
            android:backgroundTint="#7A090D"
            android:fontFamily="@font/arimo_bold"
            android:includeFontPadding="false"
            android:text="@string/card_maker_btn_share"
            android:textAllCaps="false"
            android:textColor="#FEE5AA"
            android:textSize="14.5sp"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="#FEE5AA" />

    </LinearLayout>

</LinearLayout>
