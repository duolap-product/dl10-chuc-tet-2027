<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvCountdownTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/arimo_bold"
        android:includeFontPadding="false"
        android:letterSpacing="0.02"
        android:text="@string/countdown_title"
        android:textColor="#FEE5AA"
        android:textSize="16.5sp" />

    <LinearLayout
        android:id="@+id/layoutDials"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Dial 1: Ngày -->
        <LinearLayout
            android:id="@+id/dialDays"
            android:layout_width="@dimen/sizeDials"
            android:layout_height="@dimen/sizeDials"
            android:background="@drawable/bg_countdown_circle"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arimo_regular"
                android:includeFontPadding="false"
                android:text="@string/countdown_con"
                android:textColor="#8D5524"
                android:textSize="9.5sp" />

            <online.duolap.tetviet.views.SlidingNumberView
                android:id="@+id/tvDays"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginTop="-1dp"
                android:layout_marginBottom="-1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arimo_bold"
                android:includeFontPadding="false"
                android:text="@string/countdown_ngay"
                android:textColor="#8D5524"
                android:textSize="11sp" />

        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- Dial 2: Giờ -->
        <LinearLayout
            android:id="@+id/dialHours"
            android:layout_width="@dimen/sizeDials"
            android:layout_height="@dimen/sizeDials"
            android:background="@drawable/bg_countdown_circle"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <Space
                android:layout_width="wrap_content"
                android:layout_height="9dp" />

            <online.duolap.tetviet.views.SlidingNumberView
                android:id="@+id/tvHours"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginTop="-1dp"
                android:layout_marginBottom="-1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arimo_bold"
                android:includeFontPadding="false"
                android:text="@string/countdown_gio"
                android:textColor="#8D5524"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- Dial 3: Phút -->
        <LinearLayout
            android:id="@+id/dialMinutes"
            android:layout_width="@dimen/sizeDials"
            android:layout_height="@dimen/sizeDials"
            android:background="@drawable/bg_countdown_circle"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <Space
                android:layout_width="wrap_content"
                android:layout_height="9dp" />

            <online.duolap.tetviet.views.SlidingNumberView
                android:id="@+id/tvMinutes"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginTop="-1dp"
                android:layout_marginBottom="-1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arimo_bold"
                android:includeFontPadding="false"
                android:text="@string/countdown_phut"
                android:textColor="#8D5524"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />

        <!-- Dial 4: Giây -->
        <LinearLayout
            android:id="@+id/dialSeconds"
            android:layout_width="@dimen/sizeDials"
            android:layout_height="@dimen/sizeDials"
            android:background="@drawable/bg_countdown_circle"
            android:elevation="4dp"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <Space
                android:layout_width="wrap_content"
                android:layout_height="9dp" />

            <online.duolap.tetviet.views.SlidingNumberView
                android:id="@+id/tvSeconds"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:layout_marginTop="-1dp"
                android:layout_marginBottom="-1dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arimo_bold"
                android:includeFontPadding="false"
                android:text="@string/countdown_giay"
                android:textColor="#8D5524"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/tvCountdownWelcome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/arimo_regular"
        android:includeFontPadding="false"
        android:text="@string/countdown_welcome"
        android:textColor="#FEE5A2"
        android:textSize="13.5sp" />

</LinearLayout>
