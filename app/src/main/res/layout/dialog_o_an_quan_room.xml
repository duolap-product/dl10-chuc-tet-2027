<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="24dp"
        android:background="@drawable/bg_dialog_wishing_modal"
        android:elevation="12dp"
        android:paddingHorizontal="22dp"
        android:paddingTop="20dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:id="@+id/btnCloseRoom"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_close_btn"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_clear"
                app:tint="#7A090D" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvOnlineTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arimo_bold"
            android:includeFontPadding="false"
            android:text="Thi Đấu Online 🌐"
            android:textColor="#8C1D24"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Quick Match Button -->
        <LinearLayout
            android:id="@+id/btnQuickMatch"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_wishing_cta_button"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvOnlineTitle">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_globe_online"
                app:tint="#FFFDF7" />

            <TextView
                android:id="@+id/tvQuickMatchText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arimo_bold"
                android:includeFontPadding="false"
                android:text="Ghép Trận Nhanh"
                android:textColor="#FFFDF7"
                android:textSize="14.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider with OR text -->
        <LinearLayout
            android:id="@+id/layoutOr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnQuickMatch">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D4AF37" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:fontFamily="@font/arimo_bold"
                android:text="HOẶC"
                android:textColor="#8D6E63"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#D4AF37" />
        </LinearLayout>

        <!-- Create Room Button -->
        <LinearLayout
            android:id="@+id/btnCreateRoom"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_wishing_stats_card"
            android:clickable="true"
            android:elevation="3dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutOr">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arimo_bold"
                android:includeFontPadding="false"
                android:text="Tạo Phòng Mới (Mã 6 Số)"
                android:textColor="#7A090D"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Join with Code Box -->
        <LinearLayout
            android:id="@+id/layoutJoinCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btnCreateRoom">

            <EditText
                android:id="@+id/etRoomCode"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_wishing_input_box"
                android:fontFamily="@font/arimo_bold"
                android:gravity="center"
                android:hint="Nhập mã phòng"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="6"
                android:textColor="#502016"
                android:textColorHint="#997C69"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/btnJoinRoom"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/bg_wishing_cta_button"
                android:clickable="true"
                android:elevation="3dp"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arimo_bold"
                    android:includeFontPadding="false"
                    android:text="Vào Phòng"
                    android:textColor="#FFFDF7"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Room Created Banner (Shown after room created) -->
        <LinearLayout
            android:id="@+id/layoutRoomCreatedInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_wishing_stats_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutJoinCode"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arimo_regular"
                android:text="Mã phòng của bạn (gửi cho bạn bè):"
                android:textColor="#7A5230"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDisplayRoomCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/arimo_bold"
                android:letterSpacing="0.2"
                android:textColor="#C62828"
                android:textSize="26sp"
                android:textStyle="bold"
                tools:text="886 688" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/arimo_regular"
                android:text="⏳ Đang đợi đối thủ tham gia..."
                android:textColor="#D32F2F"
                android:textSize="11.5sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>

