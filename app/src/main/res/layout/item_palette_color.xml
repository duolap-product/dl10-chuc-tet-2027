<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="44dp"
    android:layout_height="44dp"
    android:layout_marginEnd="8dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Outer selection ring -->
    <View
        android:id="@+id/viewSelectionRing"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_color_selection_ring"
        android:visibility="gone" />

    <!-- Color circle -->
    <View
        android:id="@+id/viewColorCircle"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_color_circle" />

    <!-- Checkmark inside when selected -->
    <ImageView
        android:id="@+id/ivCheckmark"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_gravity="center"
        android:contentDescription="Đã chọn"
        android:src="@drawable/ic_clear"
        android:visibility="gone" />

</FrameLayout>
