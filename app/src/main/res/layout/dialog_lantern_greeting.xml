<?xml version="1.0" encoding="utf-8"?>
<!-- Hộp thoại lời chúc ngẫu nhiên khi chạm đèn lồng trên Cây Điều Ước -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="24dp"
        android:background="@drawable/bg_dialog_wishing_modal"
        android:elevation="12dp"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginStart="-12dp"
            android:layout_marginTop="-8dp"
            android:alpha="0.85"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_bg_blossom_branch_left"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/btnCloseGreeting"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_circle_close_btn"
            android:clickable="true"
            android:contentDescription="@string/action_close"
            android:elevation="4dp"
            android:focusable="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_clear"
                app:tint="#7A090D" />
        </FrameLayout>

        <!-- Đèn lồng có quầng sáng -->
        <FrameLayout
            android:id="@+id/layoutGreetingLantern"
            android:layout_width="110dp"
            android:layout_height="112dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivGreetingGlow"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:importantForAccessibility="no"
                android:src="@drawable/bg_wishing_lantern_glow" />

            <ImageView
                android:layout_width="52dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wishing_lantern" />

            <ImageView
                android:id="@+id/ivGreetingLight"
                android:layout_width="52dp"
                android:layout_height="100dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wishing_lantern_light" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvGreetingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/lobster_regular"
            android:includeFontPadding="false"
            android:text="@string/wishing_lantern_dialog_title"
            android:textColor="#8C1D24"
            android:textSize="22sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layoutGreetingLantern" />

        <FrameLayout
            android:id="@+id/cardGreetingBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_wishing_scroll_banner"
            android:paddingHorizontal="20dp"
            android:paddingVertical="18dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvGreetingTitle">

            <TextView
                android:id="@+id/tvGreetingContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/arimo_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"
                android:minLines="3"
                android:textColor="#5A1516"
                android:textSize="15.5sp"
                tools:text="“Năm mới chúc bạn an khang thịnh vượng, vạn sự như ý, nụ cười luôn rạng rỡ trên môi.”" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvGreetingHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/arimo_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/wishing_lantern_dialog_hint"
            android:textColor="#8A6040"
            android:textSize="12sp"
            android:textStyle="italic"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cardGreetingBody" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvGreetingHint">

            <LinearLayout
                android:id="@+id/btnAnotherGreeting"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:background="@drawable/bg_wishing_stats_card"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_wish_leaf_other" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arimo_bold"
                    android:includeFontPadding="false"
                    android:text="@string/wishing_lantern_btn_another"
                    android:textColor="#7A090D"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnShareGreeting"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_wishing_cta_button"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_share"
                    app:tint="#FFFDF7" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arimo_bold"
                    android:includeFontPadding="false"
                    android:text="@string/action_share"
                    android:textColor="#FFFDF7"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
