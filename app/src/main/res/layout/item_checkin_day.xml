<?xml version="1.0" encoding="utf-8"?>
<!-- Một ô ngày trong chuỗi điểm danh 7 ngày (khu game ở màn hình chính và hộp thoại điểm danh) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dayRoot"
    android:layout_width="0dp"
    android:layout_height="58dp"
    android:layout_marginHorizontal="2dp"
    android:layout_weight="1"
    android:background="@drawable/bg_checkin_day_future"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/tvDayLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/arimo_bold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#8D5524"
        android:textSize="9.5sp"
        tools:text="Ngày 1" />

    <FrameLayout
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginVertical="2dp">

        <ImageView
            android:id="@+id/ivDayIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_coin_gold" />

        <ImageView
            android:id="@+id/ivDayCheck"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_check"
            android:visibility="gone"
            app:tint="#7A090D" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvDayReward"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/arimo_bold"
        android:includeFontPadding="false"
        android:textColor="#7A090D"
        android:textSize="10.5sp"
        tools:text="+100" />

</LinearLayout>
