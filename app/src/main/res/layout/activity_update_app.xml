<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootUpdateApp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFBF4">

    <!-- Top Action Bar with Dismiss/Close Button -->
    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_circle_close_btn"
        android:contentDescription="Đóng"
        android:padding="10dp"
        android:src="@drawable/ic_clear"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#594E43" />

    <!-- Centered Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnClose">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- Hero Festive Illustration Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardBanner"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeColor="#F0E3D3"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/ivHeaderArt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/img_update_tet_header" />

                    <!-- Gradient overlay at bottom of image for badge legibility -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_bottom_navigation" />

                    <!-- Floating Badge -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="16dp"
                        android:layout_marginBottom="14dp"
                        android:background="@drawable/bg_version_badge"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Sparkle"
                            android:src="@drawable/ic_sparkle"
                            app:tint="#B8860B" />

                        <TextView
                            android:id="@+id/tvUpdateBadgeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/arimo_bold"
                            android:includeFontPadding="false"
                            android:text="@string/update_header_better_badge"
                            android:textColor="#8A5A00"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Title -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/arimo_bold"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/update_better_title"
                android:textColor="#7A090D"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Version Comparison Row -->
            <LinearLayout
                android:id="@+id/layoutVersionRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_chip_unselected"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingVertical="7dp">

                <TextView
                    android:id="@+id/tvCurrentVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arimo_regular"
                    android:includeFontPadding="false"
                    android:text="@string/update_current_ver"
                    android:textColor="#786B5E"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="8dp"
                    android:contentDescription="Next"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#8A000A" />

                <TextView
                    android:id="@+id/tvNewVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arimo_bold"
                    android:includeFontPadding="false"
                    android:text="@string/update_new_ver"
                    android:textColor="#8A000A"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Subtitle highlighting superior update -->
            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/arimo_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:lineSpacingExtra="4dp"
                android:text="@string/update_better_subtitle"
                android:textColor="#594E43"
                android:textSize="14.5sp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Actions Container -->
    <LinearLayout
        android:id="@+id/layoutBottomActions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFBF4"
        android:elevation="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Primary Action Button with Countdown -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateNow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#7A090D"
            android:fontFamily="@font/arimo_bold"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/update_btn_update"
            android:textColor="#FFF7E6"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:elevation="3dp"
            app:icon="@drawable/ic_rocket_launch"
            app:iconGravity="textStart"
            app:iconPadding="10dp"
            app:iconSize="22dp"
            app:iconTint="#FFD700" />

        <!-- Automatic Redirect Notice -->
        <TextView
            android:id="@+id/tvAutoRedirectNotice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/arimo_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/update_auto_redirect_notice"
            android:textColor="#8E8275"
            android:textSize="12.5sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
