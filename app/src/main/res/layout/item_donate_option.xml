<?xml version="1.0" encoding="utf-8"?>
<!-- Một mức "mời cà phê" trong dialog_donate_coffee.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/donateOptionRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_checkin_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/ivDonateIcon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_donate_coffee" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDonateTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arimo_bold"
            android:includeFontPadding="false"
            android:textColor="#7A090D"
            android:textSize="15sp"
            tools:text="Cà phê đen" />

        <TextView
            android:id="@+id/tvDonateDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/arimo_regular"
            android:includeFontPadding="false"
            android:textColor="#8D5524"
            android:textSize="12sp"
            tools:text="Một ly cho buổi sáng tỉnh táo" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDonatePrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_wishing_cta_button"
        android:fontFamily="@font/arimo_bold"
        android:includeFontPadding="false"
        android:minWidth="84dp"
        android:gravity="center"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"
        android:textColor="#FFFDF7"
        android:textSize="13.5sp"
        tools:text="20.000 ₫" />

</LinearLayout>
