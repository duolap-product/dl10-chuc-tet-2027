<?xml version="1.0" encoding="utf-8"?>
<!-- Lời cảm ơn sau khi người dùng mời cà phê thành công -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="24dp"
        android:background="@drawable/bg_dialog_wishing_modal"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="22dp"
        android:paddingTop="22dp"
        android:paddingBottom="22dp">

        <ImageView
            android:id="@+id/ivThanksIcon"
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_donate_milk_coffee" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/lobster_regular"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/donate_thanks_title"
            android:textColor="#8C1D24"
            android:textSize="23sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/arimo_regular"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:text="@string/donate_thanks_desc"
            android:textColor="#6B3F21"
            android:textSize="14sp" />

        <FrameLayout
            android:id="@+id/btnThanksClose"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_wishing_cta_button"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/arimo_bold"
                android:includeFontPadding="false"
                android:text="@string/donate_thanks_btn"
                android:textColor="#FFFDF7"
                android:textSize="14.5sp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
