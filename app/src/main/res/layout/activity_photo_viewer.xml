<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootViewer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0A09">

    <!-- Lớp hình ảnh nền Blur mượt mà (Hai lớp để Cross-fade khi đổi ảnh) -->
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBlurBackgroundBack"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/bg_card_free_01" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/ivBlurBackgroundFront"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/bg_card_free_01" />

    <!-- Lớp phủ tối nhẹ mờ sương tăng độ tương phản và chiều sâu cho ảnh chính -->
    <View
        android:id="@+id/viewDarkOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#590A0605"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ViewPager2 chính: Vuốt trái phải chuyển ảnh mượt mà -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerPhotos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Action Bar (Glassmorphic) -->
    <LinearLayout
        android:id="@+id/topBarViewer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Nút quay lại dạng tròn glassmorphism -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_color_circle"
            android:backgroundTint="#66000000"
            android:contentDescription="Quay lại"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#FFFFFF" />

        <!-- Chỉ số trang (VD: 3 / 12) -->
        <TextView
            android:id="@+id/tvCounter"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_glass_pill"
            android:fontFamily="@font/liberationsans_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingHorizontal="14dp"
            android:text="1 / 12"
            android:textColor="#FFE5AA"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Nút Chia sẻ ảnh -->
        <ImageButton
            android:id="@+id/btnSharePhoto"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_color_circle"
            android:backgroundTint="#66000000"
            android:contentDescription="Chia sẻ ảnh Tết"
            android:padding="10dp"
            android:src="@drawable/ic_share"
            app:tint="#FFFFFF" />

        <!-- Nút Tải ảnh về máy -->
        <ImageButton
            android:id="@+id/btnDownloadPhoto"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_color_circle"
            android:backgroundTint="#66000000"
            android:contentDescription="Tải ảnh về máy"
            android:padding="10dp"
            android:src="@drawable/ic_download"
            app:tint="#FFD700" />

    </LinearLayout>

    <!-- Bottom Info Card (Thông tin ảnh Tết nghệ thuật) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardBottomInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="18dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#D91E1410"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="#38FFFFFF"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPhotoTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/liberationsans_bold"
                    android:includeFontPadding="false"
                    android:textColor="#FFF4DF"
                    android:textSize="16.5sp"
                    android:textStyle="bold"
                    tools:text="Hoa Mai Vàng Phú Quý" />

                <TextView
                    android:id="@+id/tvPhotoCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_version_badge"
                    android:fontFamily="@font/liberationsans_bold"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="#B8860B"
                    android:textSize="11sp"
                    tools:text="Hoa Xuân" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvPhotoDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/liberationsans_regular"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:textColor="#D6C8BA"
                android:textSize="13sp"
                tools:text="Hoa mai vàng nở rộ đón xuân sang, mang tài lộc và phú quý đến mọi nhà." />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
