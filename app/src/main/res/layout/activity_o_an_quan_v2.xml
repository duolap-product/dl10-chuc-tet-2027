<?xml version="1.0" encoding="utf-8"?>
<!-- Ô Ăn Quan v2. Bản cũ vẫn giữ ở activity_o_an_quan.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootOAnQuan"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_oaq_scene"
    android:clipChildren="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/gameContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false">

        <ImageView
            android:id="@+id/ivGarland"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:alpha="0.55"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_dc_lantern_garland"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Thanh trên: quay lại, tiêu đề + chế độ, Xu, luật chơi -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_back_button"
                android:contentDescription="@string/action_back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFE8A3" />

            <LinearLayout
                android:id="@+id/layoutTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGameTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lobster_regular"
                    android:includeFontPadding="false"
                    android:shadowColor="#B3000000"
                    android:shadowDy="3"
                    android:shadowRadius="6"
                    android:text="@string/oanquan_title"
                    android:textColor="#FFE8A3"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/tvModeSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_dc_hud_chip"
                    android:fontFamily="@font/arimo_bold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="#FFFFE0B2"
                    android:textSize="11sp"
                    tools:text="Chơi với Máy · Vừa sức ▾" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/coinChip"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_dc_hud_chip"
                android:gravity="center_vertical"
                android:minWidth="44dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_coin_gold" />

                <TextView
                    android:id="@+id/tvCoins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/arimo_bold"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    tools:text="1250" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnRules"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_back_button"
                android:contentDescription="@string/oanquan_rules_title"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_help_question"
                app:tint="#FFE8A3" />
        </LinearLayout>

        <!-- Đối thủ (phía trên bàn cờ) -->
        <LinearLayout
            android:id="@+id/layoutOpponent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_oaq_player_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toTopOf="@id/boardView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintVertical_chainStyle="packed">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_oaq_avatar_ring">

                <ImageView
                    android:id="@+id/ivOpponentAvatar"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_bot_ai" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvOpponentName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/arimo_bold"
                        android:maxLines="1"
                        android:textColor="#FFFFF8E1"
                        android:textSize="15sp"
                        tools:text="Máy (Vừa sức)" />

                    <TextView
                        android:id="@+id/tvOpponentTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_badge_ads"
                        android:fontFamily="@font/arimo_bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:textColor="#FFFDF7"
                        android:textSize="10.5sp"
                        android:visibility="gone"
                        tools:text="30s" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvOpponentTurnBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_oaq_turn_waiting"
                    android:fontFamily="@font/arimo_bold"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="@string/oanquan_turn_waiting"
                    android:textColor="#FFFFF8E1"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/boxOpponentScore"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_oaq_score_box"
                android:gravity="center_vertical"
                android:minWidth="76dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_oaq_stone" />

                <TextView
                    android:id="@+id/tvOpponentScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/arimo_bold"
                    android:text="0"
                    android:textColor="#FFC62828"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <online.duolap.tetviet.game.oanquan.ui.OaqBoardView
            android:id="@+id/boardView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="6dp"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@id/layoutPlayer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layoutOpponent" />

        <!-- Người chơi (phía dưới bàn cờ) -->
        <LinearLayout
            android:id="@+id/layoutPlayer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_oaq_player_card_active"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            app:layout_constraintBottom_toTopOf="@id/layoutBottomControls"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/boardView">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_oaq_avatar_ring">

                <ImageView
                    android:id="@+id/ivPlayerAvatar"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/sticker_fortune_cat" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPlayerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arimo_bold"
                    android:maxLines="1"
                    android:text="@string/oanquan_you"
                    android:textColor="#FFFFF8E1"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvPlayerTurnBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_oaq_turn_active"
                    android:fontFamily="@font/arimo_bold"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="@string/oanquan_turn_your"
                    android:textColor="#FF7A090D"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/boxPlayerScore"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_oaq_score_box"
                android:gravity="center_vertical"
                android:minWidth="76dp"
                android:orientation="horizontal"
                android:paddingHorizontal="10dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_oaq_stone" />

                <TextView
                    android:id="@+id/tvPlayerScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/arimo_bold"
                    android:text="0"
                    android:textColor="#FFC62828"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Nút điều khiển -->
        <LinearLayout
            android:id="@+id/layoutBottomControls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:clipChildren="false"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <FrameLayout
                android:id="@+id/btnHint"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:clipChildren="false">

                <LinearLayout
                    android:id="@+id/btnHintInner"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_dc_btn_gold"
                    android:duplicateParentState="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingBottom="6dp">

                    <ImageView
                        android:id="@+id/ivHintIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_oaq_bulb" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/arimo_bold"
                        android:text="@string/oanquan_btn_hint"
                        android:textColor="#FF7A090D"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvHintTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="-8dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/bg_oaq_tag_free"
                    android:fontFamily="@font/arimo_bold"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="@string/oanquan_free"
                    android:textColor="#FFFFFFFF"
                    android:textSize="10sp" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/btnUndo"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dc_btn_green"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_dc_video" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/arimo_bold"
                    android:text="@string/oanquan_btn_undo"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnNewGame"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dc_btn_red"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_replay"
                    app:tint="#FFFFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/arimo_bold"
                    android:text="@string/oanquan_btn_new_game"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Lớp hiệu ứng: hạt, chữ nổi -->
    <online.duolap.tetviet.game.dapchuot.ui.DapChuotEffectsView
        android:id="@+id/effectsView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:fontFamily="@font/arimo_bold"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:shadowColor="#E6000000"
        android:shadowDy="4"
        android:shadowRadius="10"
        android:textColor="#FFFFEB3B"
        android:textSize="34sp"
        android:visibility="gone"
        tools:text="Ăn Quan! +15" />

    <!-- Màn mở ván: Bạn VS Máy -->
    <FrameLayout
        android:id="@+id/introOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/introContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tvIntroYou"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/arimo_bold"
                android:gravity="center"
                android:shadowColor="#E6000000"
                android:shadowDy="3"
                android:shadowRadius="8"
                android:text="@string/oanquan_you"
                android:textColor="#FFFFF8E1"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/tvIntroVs"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_oaq_intro_badge"
                android:fontFamily="@font/lobster_regular"
                android:gravity="center"
                android:text="@string/oanquan_vs"
                android:textColor="#FF7A090D"
                android:textSize="30sp" />

            <TextView
                android:id="@+id/tvIntroOpp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/arimo_bold"
                android:gravity="center"
                android:shadowColor="#E6000000"
                android:shadowDy="3"
                android:shadowRadius="8"
                android:textColor="#FFFFF8E1"
                android:textSize="24sp"
                tools:text="Máy (Vừa sức)" />
        </LinearLayout>
    </FrameLayout>

    <!-- Thẻ kết quả (nạp từ dialog_o_an_quan_result_v2.xml) -->
    <FrameLayout
        android:id="@+id/resultOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:clipChildren="false"
        android:focusable="true"
        android:paddingHorizontal="16dp"
        android:visibility="gone" />

    <online.duolap.tetviet.game.dapchuot.ui.DapChuotEffectsView
        android:id="@+id/resultEffectsView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
