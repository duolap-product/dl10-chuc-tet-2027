<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_tet_countdown_v2"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <ImageView
        android:layout_width="28dp"
        android:layout_height="14dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="6dp"
        android:layout_marginTop="2dp"
        android:alpha="0.95"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/bg_cloud_02" />

    <ImageView
        android:layout_width="30dp"
        android:layout_height="1.5dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="32dp"
        android:layout_marginTop="11dp"
        android:background="@drawable/bg_widget_cloud_tail"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="20dp"
        android:layout_gravity="bottom|start"
        android:alpha="0.95"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/bg_cloud_01" />

    <ImageView
        android:layout_width="30dp"
        android:layout_height="1.5dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="36dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/bg_widget_cloud_tail"
        android:importantForAccessibility="no" />

    <ImageView
        android:layout_width="28dp"
        android:layout_height="14dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="6dp"
        android:alpha="0.95"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:scaleX="-1"
        android:src="@drawable/bg_cloud_02" />

    <ImageView
        android:layout_width="30dp"
        android:layout_height="1.5dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="11dp"
        android:layout_marginEnd="32dp"
        android:background="@drawable/bg_widget_cloud_tail"
        android:importantForAccessibility="no"
        android:scaleX="-1" />

    <ImageView
        android:layout_width="40dp"
        android:layout_height="20dp"
        android:layout_gravity="bottom|end"
        android:alpha="0.95"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:scaleX="-1"
        android:src="@drawable/bg_cloud_01" />

    <ImageView
        android:layout_width="30dp"
        android:layout_height="1.5dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/bg_widget_cloud_tail"
        android:importantForAccessibility="no"
        android:scaleX="-1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_widget_lixi_icon"
            android:importantForAccessibility="no"
            android:padding="6dp"
            android:src="@drawable/ic_custom_red_packet" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvWidgetPrefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arimo_bold"
                    android:maxLines="1"
                    android:text="@string/widget_prefix"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvWidgetDays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arimo_bold"
                    android:includeFontPadding="false"
                    android:text="@string/widget_lixi_preview_days"
                    android:textColor="#FFD86B"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWidgetDaysUnit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arimo_bold"
                    android:maxLines="1"
                    android:text="@string/widget_preview_days_unit"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <Chronometer
                    android:id="@+id/chronoWidget"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arimo_bold"
                    android:textColor="#FFD86B"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tvWidgetSuffix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/widget_suffix"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressWidget"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="75"
                    android:progressDrawable="@drawable/widget_progress_lixi" />

                <TextView
                    android:id="@+id/tvWidgetProgress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/arimo_bold"
                    android:text="@string/widget_preview_progress"
                    android:textColor="#FFD86B"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWidgetInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/arimo_regular"
                android:maxLines="1"
                android:text="@string/widget_preview_info"
                android:textColor="#F7D9C4"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
