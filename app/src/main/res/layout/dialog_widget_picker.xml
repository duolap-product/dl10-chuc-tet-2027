<?xml version="1.0" encoding="utf-8"?>
<!-- Bảng chọn widget (MainActivity.showWidgetPickerDialog). Ô xem trước được lấp bằng RemoteViews thật của từng widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_settings_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="28dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="#D1C7B7" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="18dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/widget_picker_title"
        android:textColor="#7A090D"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="2dp"
        android:fontFamily="sans-serif"
        android:text="@string/widget_picker_desc"
        android:textColor="#8C6E52"
        android:textSize="13sp" />

    <!-- Mẫu Cổ điển -->
    <LinearLayout
        android:id="@+id/cardPickClassic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_settings_group"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Lớp phủ trong suốt nằm trên bản xem trước để chạm vào thẻ, không mở app -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="84dp">

            <FrameLayout
                android:id="@+id/previewClassicContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:id="@+id/overlayClassic"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_picker_classic_name"
            android:textColor="#3D3025"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="@string/widget_picker_classic_desc"
            android:textColor="#8C6E52"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- Mẫu Lì xì -->
    <LinearLayout
        android:id="@+id/cardPickLixi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_settings_group"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="96dp">

            <FrameLayout
                android:id="@+id/previewLixiContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <View
                android:id="@+id/overlayLixi"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/widget_picker_lixi_name"
            android:textColor="#3D3025"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="sans-serif"
            android:text="@string/widget_picker_lixi_desc"
            android:textColor="#8C6E52"
            android:textSize="12.5sp" />
    </LinearLayout>

</LinearLayout>
