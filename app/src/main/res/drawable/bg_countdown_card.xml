<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Shadow / Dark Accent -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#40000000" />
        </shape>
    </item>

    <!-- Main Card Body with Rich Wine-Red Gradient -->
    <item
        android:bottom="2dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient
                android:angle="270"
                android:endColor="#540206"
                android:startColor="#7F050D" />
            <stroke
                android:width="2dp"
                android:color="#E8BC68" />
        </shape>
    </item>

    <!-- Inner Golden Frame -->
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke
                android:width="1dp"
                android:color="#88E5BA6A" />
        </shape>
    </item>
</layer-list>
