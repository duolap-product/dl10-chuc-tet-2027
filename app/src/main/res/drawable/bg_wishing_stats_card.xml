<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33D32F2F">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="24dp" />
                    <solid android:color="#ECCB8F" />
                </shape>
            </item>
            <item
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="22dp" />
                    <gradient
                        android:angle="270"
                        android:startColor="#FFFBF2"
                        android:endColor="#FDF2DF" />
                    <stroke
                        android:width="1.2dp"
                        android:color="#DFC17E" />
                </shape>
            </item>
            <item
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="19dp" />
                    <stroke
                        android:width="0.8dp"
                        android:color="#EEDBB0" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>

