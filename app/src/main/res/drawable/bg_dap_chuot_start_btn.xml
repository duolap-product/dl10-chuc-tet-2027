<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#B8860B"/>
                    <corners android:radius="28dp"/>
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FFD700" android:endColor="#D4AF37"/>
                    <corners android:radius="28dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#8B6914"/>
                    <corners android:radius="28dp"/>
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#FFE566" android:endColor="#D4AF37"/>
                    <corners android:radius="28dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
