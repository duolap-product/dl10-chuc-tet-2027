<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Drop Shadow / Bottom Border in Brilliant Gold -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E8BC68" />
        </shape>
    </item>

    <!-- Main Solid Header Body in Deep Royal Red -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#F2380004"
                android:startColor="#FA580207" />
        </shape>
    </item>
</layer-list>
