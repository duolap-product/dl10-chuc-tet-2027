        android:pathData="M7.6,29 Q13.8,29 13.8,22.6 L50.2,22.6 Q50.2,29 56.4,29 L56.4,87.2 Q56.4,89.4 54.2,89.4 L9.8,89.4 Q7.6,89.4 7.6,87.2 Z"
