<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#80FFD700">
    <item>
        <layer-list>
            <!-- Outer Gold Frame with Drop Shadow -->
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <gradient
                        android:angle="135"
                        android:endColor="#FFA000"
                        android:startColor="#FFE59F" />
                </shape>
            </item>

            <!-- Inner Solid Button Face -->
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <corners android:radius="12dp" />
                    <gradient
                        android:angle="270"
                        android:endColor="#540206"
                        android:startColor="#8A000A" />
                    <stroke
                        android:width="1dp"
                        android:color="#80FFE5AA" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
