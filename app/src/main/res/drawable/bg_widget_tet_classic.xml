<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="60dp" />
            <gradient
                android:angle="0"
                android:centerColor="#D61E26"
                android:endColor="#8C0B12"
                android:startColor="#8C0B12" />
            <stroke
                android:width="2dp"
                android:color="#E9B949" />
        </shape>
    </item>

    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="56dp" />
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="#B8862E" />
        </shape>
    </item>

</layer-list>
