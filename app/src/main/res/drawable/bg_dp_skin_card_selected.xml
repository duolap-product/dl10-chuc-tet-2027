<?xml version="1.0" encoding="utf-8"?>
<!-- Thẻ trang phục đang dùng trong Cửa hàng Dê -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22C62828">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <gradient android:angle="270" android:startColor="#FFF6D6" android:endColor="#FFD98A" />
            <stroke android:width="2.5dp" android:color="#C62828" />
        </shape>
    </item>
</ripple>
